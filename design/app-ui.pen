    {
     "type": "text",
     "id": "AYoNJ",
     "name": "Spec summary",
     "fill": "$muted",
     "content": "The landing page's design language, applied to the app: a dark surface stack, one orange accent, Plus Jakarta Sans, generous radii. The shell is a persistent sidebar with the live player as the home screen.",
