{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch OpenStream TV",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["build", "--bin", "openstream"],
                "filter": { "name": "openstream", "kind": "bin" }
            },
            "args": ["--skip-update-check", "serve"],
            "cwd": "${workspaceFolder}"
        }
    ]
}
